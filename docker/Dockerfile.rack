FROM python:3.12-slim

# rack shares keripy's native dependencies (libsodium/blake3/etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    curl \
    libsodium-dev \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    KERI_BASER_MAP_SIZE=1099511627776

WORKDIR /app/rack

# rack isn't published anywhere castellan can pip-install from, so we install
# a wheel checked into rack/ in this repo instead of a package index/git URL.
COPY rack/rack-1.2.0-py3-none-any.whl ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ./rack-1.2.0-py3-none-any.whl

COPY docker/scripts/castellan-rack.sh /app/rack/docker/scripts/castellan-rack.sh
RUN chmod +x /app/rack/docker/scripts/castellan-rack.sh

RUN mkdir -p /usr/local/var/keri/cf/main

ENTRYPOINT ["/bin/bash"]